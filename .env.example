# EquipMind A1 大模型配置模板
# 重要：不要把真实 .env 或 API Key 上传到比赛平台、GitHub、网盘或公开聊天。
# 正式使用请复制本文件为 .env，或运行：python scripts/init_deepseek.py

# 推荐演示配置：DeepSeek OpenAI-compatible Chat API
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-请替换为你自己的DeepSeekKey
# 也兼容官方示例变量名；二选一即可，保留两个也可以。
DEEPSEEK_API_KEY=sk-请替换为你自己的DeepSeekKey
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2

# DeepSeek V4 可选思考模式。演示默认关闭，速度更快、费用更低。
# 决赛答辩或复杂推理可改为 true。
LLM_DEEPSEEK_THINKING=false
LLM_REASONING_EFFORT=high

# 示例 2：DeepSeek Pro，效果更强但可能更慢/成本更高
# LLM_MODEL=deepseek-v4-pro
# LLM_DEEPSEEK_THINKING=true

# 示例 3：通义千问 / 阿里云百炼（OpenAI-compatible）
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-你的百炼Key
# LLM_MODEL=qwen-plus

# 示例 4：Ollama 本地模型
# 先运行：ollama pull qwen3:8b
# 再运行：ollama serve
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# 示例 5：其他 OpenAI-compatible 服务
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://你的服务地址/v1
# LLM_API_KEY=你的APIKey
# LLM_MODEL=你的模型名

# 可选：视觉大模型，用于故障图片初筛。没有视觉模型时保持 false。
LLM_ENABLE_VISION=false
LLM_VISION_MODEL=
